# Runtime: local, test, demo, or production.
ENVIRONMENT=local
# deterministic is explicit and clearly identified in responses; production requires live.
PROVIDER_MODE=deterministic
DATABASE_URL=postgresql+asyncpg://chirpy:chirpy@localhost:5432/chirpy
# Neon also works directly. Copy its pooled connection string as provided:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
ADMIN_API_KEY=replace-with-a-long-random-admin-key
ADMIN_DISPLAY_NAME=Modo Studio
ADMIN_SESSION_HOURS=12
VISITOR_SESSION_DAYS=30
VISITOR_PRESENCE_SECONDS=75
CONVERSATION_ARCHIVE_AFTER_HOURS=24
# Use none (with HTTPS) only when the frontend and API are on different sites.
VISITOR_COOKIE_SAMESITE=lax
CONVERSATION_TOKEN_PEPPER=replace-with-a-long-random-pepper
BUSINESS_CONFIG_PATH=config/business.v1.json
ASSISTANT_CONFIG_PATH=config/assistant.v1.json
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
LOG_CONVERSATION_CONTENT=false

LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
EMBEDDING_PROVIDER=cloudflare
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSION=768
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-base-en-v1.5
VECTOR_PROVIDER=pinecone
PINECONE_API_KEY=
VECTOR_INDEX_NAME=modo-studio-knowledge
VECTOR_COLLECTION=modo-studio-v1
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=10
# Use jina for lightweight deployments. Local requires requirements-local-ml.txt.
RERANKER_PROVIDER=jina
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
JINA_API_KEY=
JINA_RERANKER_MODEL=jina-reranker-v3.5
RETRIEVAL_RELEVANCE_THRESHOLD=0.60
PROVIDER_TIMEOUT_SECONDS=20
PROVIDER_MAX_RETRIES=2

HISTORY_TOKEN_BUDGET=1800
SUMMARY_TRIGGER_TOKENS=2400
MAX_MESSAGE_CHARS=8000
MAX_UPLOAD_BYTES=5000000
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=150
REQUESTS_PER_MINUTE=60
ADMIN_REQUESTS_PER_MINUTE=600
