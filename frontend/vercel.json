{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://modo-studio-intelligence-desk-api.onrender.com/api/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://modo-studio-intelligence-desk-api.onrender.com/health/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
